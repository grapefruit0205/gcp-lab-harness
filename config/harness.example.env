# Copy to config/harness.env. Never commit the populated file.
HARNESS_ENVIRONMENT=lab
GCP_PROJECT_ID=
GCP_ALLOWED_PROJECTS=
GCP_BILLING_ACCOUNT_ID=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_SECONDARY_REGION=europe-west1
GCP_SECONDARY_ZONE=europe-west1-b
GCP_IMPERSONATE_SERVICE_ACCOUNT=
GCP_RESOURCE_PREFIX=gcp-lab-harness
GCP_CLEANUP_ON_FAILURE=true
GCP_MAX_APPLY_MINUTES=45
GCP_MAX_RESOURCES_PER_PHASE=30
GCP_MCP_MONITORING_ENABLED=true
GCP_MCP_LOGGING_ENABLED=true
GCP_MCP_VERIFIER_SERVICE_ACCOUNT=
GCP_MCP_MODE=remote
