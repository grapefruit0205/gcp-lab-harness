{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCP lab harness phase manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "run_id", "project_id_hash", "status", "resources", "checks", "cleanup"],
  "properties": {
    "phase": { "type": "string", "pattern": "^[0-9]{2}$" },
    "run_id": { "type": "string", "minLength": 8 },
    "project_id_hash": { "type": "string", "minLength": 8 },
    "status": { "enum": ["planned", "applied", "verified", "failed", "destroyed", "cleanup_required"] },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name_hash", "region"],
        "properties": {
          "kind": { "type": "string" },
          "name_hash": { "type": "string" },
          "region": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remaining_resource_count"],
      "properties": {
        "status": { "enum": ["not_started", "completed", "failed"] },
        "remaining_resource_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
