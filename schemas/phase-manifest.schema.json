{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCP lab harness phase manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "run_id", "project_id_hash", "status", "resources", "checks", "cleanup"],
  "allOf": [
    {
      "if": { "properties": { "phase": { "pattern": "^(0[7-9]|1[0-5])$" } } },
      "then": { "required": ["source_tasks", "plan"] }
    }
  ],
  "properties": {
    "phase": { "type": "string", "pattern": "^[0-9]{2}$" },
    "run_id": { "type": "string", "minLength": 8 },
    "project_id_hash": { "type": "string", "minLength": 8 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "client_source_cidr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terraform_sha256", "action_plan_sha256", "bundle_sha256"],
      "properties": {
        "terraform_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "action_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "source_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "title", "classification", "evidence_contract"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]+$" },
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["automated", "cli-equivalent", "manual-boundary", "blocked", "conditional", "automated-required", "automated/conditional"]
          },
          "evidence_contract": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": { "enum": ["planned", "applied", "verified", "failed", "destroyed", "cleanup_required"] },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name_hash", "region"],
        "properties": {
          "kind": { "type": "string" },
          "name_hash": { "type": "string" },
          "region": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pending", "passed", "failed", "skipped", "blocked", "manual-boundary"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remaining_resource_count"],
      "properties": {
        "status": { "enum": ["not_started", "completed", "failed"] },
        "remaining_resource_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
