#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export HARNESS_REPO_ROOT="$repo_root"
source "$repo_root/lib/harness/gate.sh"
cd "$repo_root"

usage() {
  cat <<'USAGE'
사용법:
  gcp-lab-harness install
  gcp-lab-harness setup <GCP_PROJECT_ID>
  gcp-lab-harness accounts setup [--user1 <관리자 이메일> --user2 <실습 이메일>] [--no-login]
  gcp-lab-harness accounts check
  gcp-lab-harness start --run <id>
  gcp-lab-harness cmd --run <id>
  gcp-lab-harness single-model run --run <id> [--confirm-plan-sha <sha256>]
  gcp-lab-harness single-model prepare --run <id> [--plan <file> --evidence <file>]
  gcp-lab-harness single-model approve --run <id>
  gcp-lab-harness handoff review --run <id> --plan <file> --evidence <file>
  gcp-lab-harness handoff next --run <id>
  gcp-lab-harness doctor
  gcp-lab-harness phase list
  gcp-lab-harness run-all --run <id>
  gcp-lab-harness run-all --dry-run
  gcp-lab-harness phase-gate <docs/phases/phase-NN-name.md>
  gcp-lab-harness run init --run <id> [--mode cloud|offline]
  gcp-lab-harness status --run <id>
  gcp-lab-harness resume --run <id>
  gcp-lab-harness transition <NN> <state> --run <id>
  gcp-lab-harness hash <file>
  gcp-lab-harness gate prepare <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256>
  gcp-lab-harness gate approve <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256> --reviewer <id>
  gcp-lab-harness gate reject <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256> --reviewer <id> --findings <file>

start/cmd는 Command Code 대화형 구현 세션을 열고, handoff는 Extension 검증과 다음 단계 재개를 연결합니다.
single-model은 같은 Command Code 고정 모델로 구현과 자기 검증을 수행하되 사용자 승인은 유지합니다.
run-all은 단일 Command Code 세션을 열고 각 Phase의 Extension 사용자 승인 gate에서 대기합니다.
USAGE
}

load_phase_docs() {
  mapfile -t phase_docs < <(
    find "$repo_root/docs/phases" -maxdepth 1 -type f \
      -name 'phase-[0-9][0-9]-*.md' -print | sort
  )
  if [[ "${#phase_docs[@]}" -ne 15 ]]; then
    printf 'FAIL: Phase 01~15 문서가 정확히 15개여야 합니다. 현재 %s개\n' "${#phase_docs[@]}" >&2
    exit 1
  fi
}

list_phases() {
  load_phase_docs
  local phase_doc
  for phase_doc in "${phase_docs[@]}"; do
    printf '%s\t%s\n' "$(basename "$phase_doc" .md | cut -d- -f2)" "$(sed -n '1s/^# //p' "$phase_doc")"
  done
}

run_all() {
  local dry_run=false run_id=""
  if [[ "${1:-}" == "--dry-run" && "$#" -eq 1 ]]; then
    dry_run=true
  else
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --run) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; run_id="$2"; shift 2 ;;
        *) usage >&2; return 2 ;;
      esac
    done
    [[ -n "$run_id" ]] || { usage >&2; return 2; }
    harness_validate_run_id "$run_id"
  fi

  load_phase_docs
  if [[ "$dry_run" == true ]]; then
    printf 'DRY RUN: Command Code cmd가 현재 고정 모델을 상속하는 15-Phase 순서를 확인합니다.\n'
    list_phases
    printf '각 Phase: pull --ff-only → cmd 실행 → machine verification → VS Code Codex Extension 검증 → 사용자 승인 → cleanup → 한국어 commit → push\n'
    printf 'Cloud·GitHub 외부 변경은 수행하지 않았습니다.\n'
    return 0
  fi

  if [[ ! -f "$repo_root/config/harness.env" ]]; then
    printf 'FAIL: config/harness.example.env를 복사해 config/harness.env를 준비하세요.\n' >&2
    exit 1
  fi
  "$repo_root/scripts/validate-design.sh" >/dev/null
  "$repo_root/tests/offline-phases-01-06.sh" >/dev/null
  "$repo_root/tests/offline-phases-07-15.sh" >/dev/null
  exec "$repo_root/scripts/start-command-code.sh" --run "$run_id"
}

parse_run_option() {
  local value=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        value="$2"
        shift 2
        ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$value" ]] || { usage >&2; return 2; }
  printf '%s\n' "$value"
}

run_init() {
  local run_id=""
  local mode="cloud"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        run_id="$2"
        shift 2
        ;;
      --mode)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        mode="$2"
        shift 2
        ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" ]] || { usage >&2; return 2; }
  harness_state_init "$run_id" "$mode"
}

gate_command() {
  local action="${1:-}"
  local phase="${2:-}"
  local run_id=""
  local plan_hash=""
  local diff_hash=""
  local evidence_hash=""
  local reviewer=""
  local findings=""
  shift $(( $# >= 2 ? 2 : $# ))

  [[ "$action" == "prepare" || "$action" == "approve" || "$action" == "reject" ]] || {
    usage >&2
    return 2
  }
  harness_validate_phase "$phase" || return
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; run_id="$2"; shift 2 ;;
      --plan-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; plan_hash="$2"; shift 2 ;;
      --diff-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; diff_hash="$2"; shift 2 ;;
      --evidence-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; evidence_hash="$2"; shift 2 ;;
      --reviewer) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; reviewer="$2"; shift 2 ;;
      --findings) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; findings="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" && -n "$plan_hash" && -n "$diff_hash" && -n "$evidence_hash" ]] || {
    usage >&2
    return 2
  }

  case "$action" in
    prepare)
      [[ -z "$reviewer" && -z "$findings" ]] || { usage >&2; return 2; }
      harness_state_prepare_review "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash"
      ;;
    approve)
      [[ -n "$reviewer" && -z "$findings" ]] || { usage >&2; return 2; }
      harness_gate_write_decision approved "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash" "$reviewer"
      ;;
    reject)
      [[ -n "$reviewer" && -n "$findings" ]] || { usage >&2; return 2; }
      harness_gate_write_decision rejected "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash" "$reviewer" "$findings"
      ;;
  esac
}

transition_command() {
  local phase="${1:-}"
  local next_state="${2:-}"
  local run_id=""
  shift $(( $# >= 2 ? 2 : $# ))
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; run_id="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" ]] || { usage >&2; return 2; }
  transition_artifact_guard "$run_id" "$phase" "$next_state"
  harness_state_transition "$run_id" "$phase" "$next_state"
}

transition_artifact_guard() {
  local run_id="$1" phase="$2" next_state="$3"
  local run_dir manifest evidence bundle expected actual
  run_dir="$(harness_run_dir "$run_id")/phase-$phase"
  manifest="$run_dir/manifest.json"
  evidence="$run_dir/evidence/phase-$phase-machine.json"
  case "$next_state" in
    planned)
      harness_require_file "$manifest" "planned manifest" || return
      jq -e '.status == "planned"' "$manifest" >/dev/null || harness_die "planned 전이는 planned manifest가 필요합니다."
      if (( 10#$phase >= 7 )); then
        bundle="$run_dir/plan-bundle.json"
        harness_require_file "$bundle" "plan bundle" || return
        expected="$(jq -r '.plan.bundle_sha256 // empty' "$manifest")"
        actual="$(harness_sha256_file "$bundle")"
        [[ "$expected" == "$actual" ]] || harness_die "planned manifest와 plan bundle hash가 일치하지 않습니다."
      fi
      ;;
    applied)
      harness_require_file "$manifest" "applied manifest" || return
      jq -e '.status == "applied"' "$manifest" >/dev/null || harness_die "applied 전이는 실제 applied manifest가 필요합니다."
      ;;
    machine_verified)
      harness_require_file "$manifest" "verified manifest" || return
      harness_require_file "$evidence" "machine evidence" || return
      jq -e '.status == "verified" and ([.checks[].status] | all(. == "passed" or . == "manual-boundary"))' \
        "$manifest" >/dev/null || harness_die "machine_verified 전이는 모든 check가 완료된 verified manifest가 필요합니다."
      jq -e --slurpfile manifest "$manifest" '
        .tasks as $tasks | ($manifest[0].source_tasks // []) as $source |
        ($tasks | type == "object" and length > 0) and
        (if ($source | length) > 0 then
          ($tasks | keys | sort) == ([$source[].id] | sort) and
          all($source[]; . as $task | $tasks[$task.id].status == "passed" or
            ($task.classification == "manual-boundary" and $tasks[$task.id].status == "manual-boundary"))
        else [$tasks[] | .status] | all(. == "passed") end)' \
        "$evidence" >/dev/null || harness_die "machine evidence의 Task 판정이 완료되지 않았습니다."
      ;;
    destroyed)
      harness_require_file "$manifest" "destroyed manifest" || return
      jq -e '.status == "destroyed" and .cleanup.status == "completed" and .cleanup.remaining_resource_count == 0' \
        "$manifest" >/dev/null || harness_die "destroyed 전이는 cleanup 잔여 0 manifest가 필요합니다."
      ;;
  esac
}

case "${1:-}" in
  install)
    [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/install-home-command.sh"
    ;;
  setup)
    [[ "$#" -eq 2 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/bootstrap-from-clone.sh" "$2"
    ;;
  start|cmd)
    shift
    exec "$repo_root/scripts/start-command-code.sh" "$@"
    ;;
  handoff)
    case "${2:-}" in
      review) shift 2; exec "$repo_root/scripts/handoff-review.sh" "$@" ;;
      next) shift 2; exec "$repo_root/scripts/handoff-next.sh" "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  single-model)
    case "${2:-}" in
      run) shift 2; exec "$repo_root/scripts/single-model-phase.sh" "$@" ;;
      prepare) shift 2; exec "$repo_root/scripts/prepare-single-model-review.sh" "$@" ;;
      approve) shift 2; exec "$repo_root/scripts/single-model-approve.sh" "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  doctor)
    [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/doctor.sh"
    ;;
  phase-gate)
    [[ "$#" -eq 2 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/phase-gate.sh" "$2"
    ;;
  accounts)
    case "${2:-}" in
      setup) shift 2; exec "$repo_root/phases/07/auth.sh" --setup "$@" ;;
      check) shift 2; exec "$repo_root/phases/07/auth.sh" --check "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  phase)
    [[ "${2:-}" == "list" && "$#" -eq 2 ]] || { usage >&2; exit 2; }
    list_phases
    ;;
  run-all)
    shift
    run_all "$@"
    ;;
  run)
    [[ "${2:-}" == "init" ]] || { usage >&2; exit 2; }
    shift 2
    run_init "$@"
    ;;
  status)
    shift
    run_id="$(parse_run_option "$@")"
    jq '{run_id, mode, status, current_phase, updated_at, phases}' "$(harness_state_read "$run_id")"
    ;;
  resume)
    shift
    run_id="$(parse_run_option "$@")"
    harness_state_next_action "$run_id"
    ;;
  transition)
    shift
    transition_command "$@"
    ;;
  hash)
    [[ "$#" -eq 2 ]] || { usage >&2; exit 2; }
    harness_sha256_file "$2"
    ;;
  gate)
    shift
    gate_command "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
