#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export HARNESS_REPO_ROOT="$repo_root"
source "$repo_root/lib/harness/gate.sh"
cd "$repo_root"

usage() {
  cat <<'USAGE'
사용법:
  gcp-lab-harness install
  gcp-lab-harness setup <GCP_PROJECT_ID>
  gcp-lab-harness start --run <id>
  gcp-lab-harness cmd --run <id>
  gcp-lab-harness single-model run --run <id> [--confirm-plan-sha <sha256>]
  gcp-lab-harness single-model prepare --run <id> [--plan <file> --evidence <file>]
  gcp-lab-harness single-model approve --run <id>
  gcp-lab-harness handoff review --run <id> --plan <file> --evidence <file>
  gcp-lab-harness handoff next --run <id>
  gcp-lab-harness doctor
  gcp-lab-harness phase list
  gcp-lab-harness run-all [--dry-run]
  gcp-lab-harness run init --run <id> [--mode cloud|offline]
  gcp-lab-harness status --run <id>
  gcp-lab-harness resume --run <id>
  gcp-lab-harness transition <NN> <state> --run <id>
  gcp-lab-harness hash <file>
  gcp-lab-harness gate prepare <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256>
  gcp-lab-harness gate approve <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256> --reviewer <id>
  gcp-lab-harness gate reject <NN> --run <id> --plan-hash <sha256> --diff-hash <sha256> --evidence-hash <sha256> --reviewer <id> --findings <file>

start/cmd는 Command Code 대화형 구현 세션을 열고, handoff는 Extension 검증과 다음 단계 재개를 연결합니다.
single-model은 같은 Command Code 고정 모델로 구현과 자기 검증을 수행하되 사용자 승인은 유지합니다.
실제 run-all은 Google Cloud adapter가 모두 준비될 때까지 차단됩니다.
USAGE
}

load_phase_docs() {
  mapfile -t phase_docs < <(
    find "$repo_root/docs/phases" -maxdepth 1 -type f \
      -name 'phase-[0-9][0-9]-*.md' -print | sort
  )
  if [[ "${#phase_docs[@]}" -ne 15 ]]; then
    printf 'FAIL: Phase 01~15 문서가 정확히 15개여야 합니다. 현재 %s개\n' "${#phase_docs[@]}" >&2
    exit 1
  fi
}

list_phases() {
  load_phase_docs
  local phase_doc
  for phase_doc in "${phase_docs[@]}"; do
    printf '%s\t%s\n' "$(basename "$phase_doc" .md | cut -d- -f2)" "$(sed -n '1s/^# //p' "$phase_doc")"
  done
}

run_all() {
  local dry_run=false
  if [[ "${1:-}" == "--dry-run" && "$#" -eq 1 ]]; then
    dry_run=true
  elif [[ "$#" -ne 0 ]]; then
    usage >&2
    exit 2
  fi

  load_phase_docs
  if [[ "$dry_run" == true ]]; then
    printf 'DRY RUN: Command Code cmd가 현재 고정 모델을 상속하는 15-Phase 순서를 확인합니다.\n'
    list_phases
    printf '각 Phase: pull --ff-only → cmd 실행 → machine verification → VS Code Codex Extension 검증 → 사용자 승인 → cleanup → 한국어 commit → push\n'
    printf 'Cloud·GitHub 외부 변경은 수행하지 않았습니다.\n'
    return 0
  fi

  "$repo_root/scripts/doctor.sh"
  if [[ ! -f "$repo_root/config/harness.env" ]]; then
    printf 'FAIL: config/harness.example.env를 복사해 config/harness.env를 준비하세요.\n' >&2
    exit 1
  fi
  printf 'BLOCKED: 상태 controller는 준비됐지만 실제 Google Cloud Phase adapter는 아직 구현되지 않았습니다.\n' >&2
  printf '불완전한 run-all이 Cloud를 변경하지 않도록 실행을 중단했습니다.\n' >&2
  exit 1
}

parse_run_option() {
  local value=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        value="$2"
        shift 2
        ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$value" ]] || { usage >&2; return 2; }
  printf '%s\n' "$value"
}

run_init() {
  local run_id=""
  local mode="cloud"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        run_id="$2"
        shift 2
        ;;
      --mode)
        [[ "$#" -ge 2 ]] || { usage >&2; return 2; }
        mode="$2"
        shift 2
        ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" ]] || { usage >&2; return 2; }
  harness_state_init "$run_id" "$mode"
}

gate_command() {
  local action="${1:-}"
  local phase="${2:-}"
  local run_id=""
  local plan_hash=""
  local diff_hash=""
  local evidence_hash=""
  local reviewer=""
  local findings=""
  shift $(( $# >= 2 ? 2 : $# ))

  [[ "$action" == "prepare" || "$action" == "approve" || "$action" == "reject" ]] || {
    usage >&2
    return 2
  }
  harness_validate_phase "$phase" || return
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; run_id="$2"; shift 2 ;;
      --plan-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; plan_hash="$2"; shift 2 ;;
      --diff-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; diff_hash="$2"; shift 2 ;;
      --evidence-hash) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; evidence_hash="$2"; shift 2 ;;
      --reviewer) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; reviewer="$2"; shift 2 ;;
      --findings) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; findings="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" && -n "$plan_hash" && -n "$diff_hash" && -n "$evidence_hash" ]] || {
    usage >&2
    return 2
  }

  case "$action" in
    prepare)
      [[ -z "$reviewer" && -z "$findings" ]] || { usage >&2; return 2; }
      harness_state_prepare_review "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash"
      ;;
    approve)
      [[ -n "$reviewer" && -z "$findings" ]] || { usage >&2; return 2; }
      harness_gate_write_decision approved "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash" "$reviewer"
      ;;
    reject)
      [[ -n "$reviewer" && -n "$findings" ]] || { usage >&2; return 2; }
      harness_gate_write_decision rejected "$run_id" "$phase" "$plan_hash" "$diff_hash" "$evidence_hash" "$reviewer" "$findings"
      ;;
  esac
}

transition_command() {
  local phase="${1:-}"
  local next_state="${2:-}"
  local run_id=""
  shift $(( $# >= 2 ? 2 : $# ))
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --run) [[ "$#" -ge 2 ]] || { usage >&2; return 2; }; run_id="$2"; shift 2 ;;
      *) usage >&2; return 2 ;;
    esac
  done
  [[ -n "$run_id" ]] || { usage >&2; return 2; }
  harness_state_transition "$run_id" "$phase" "$next_state"
}

case "${1:-}" in
  install)
    [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/install-home-command.sh"
    ;;
  setup)
    [[ "$#" -eq 2 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/bootstrap-from-clone.sh" "$2"
    ;;
  start|cmd)
    shift
    exec "$repo_root/scripts/start-command-code.sh" "$@"
    ;;
  handoff)
    case "${2:-}" in
      review) shift 2; exec "$repo_root/scripts/handoff-review.sh" "$@" ;;
      next) shift 2; exec "$repo_root/scripts/handoff-next.sh" "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  single-model)
    case "${2:-}" in
      run) shift 2; exec "$repo_root/scripts/single-model-phase.sh" "$@" ;;
      prepare) shift 2; exec "$repo_root/scripts/prepare-single-model-review.sh" "$@" ;;
      approve) shift 2; exec "$repo_root/scripts/single-model-approve.sh" "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  doctor)
    [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
    exec "$repo_root/scripts/doctor.sh"
    ;;
  phase)
    [[ "${2:-}" == "list" && "$#" -eq 2 ]] || { usage >&2; exit 2; }
    list_phases
    ;;
  run-all)
    shift
    run_all "$@"
    ;;
  run)
    [[ "${2:-}" == "init" ]] || { usage >&2; exit 2; }
    shift 2
    run_init "$@"
    ;;
  status)
    shift
    run_id="$(parse_run_option "$@")"
    jq '{run_id, mode, status, current_phase, updated_at, phases}' "$(harness_state_read "$run_id")"
    ;;
  resume)
    shift
    run_id="$(parse_run_option "$@")"
    harness_state_next_action "$run_id"
    ;;
  transition)
    shift
    transition_command "$@"
    ;;
  hash)
    [[ "$#" -eq 2 ]] || { usage >&2; exit 2; }
    harness_sha256_file "$2"
    ;;
  gate)
    shift
    gate_command "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
